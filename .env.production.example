# Producao Rodogarcia. Copie para .env.production.local na VM e preencha valores reais.
# Nunca versione a copia local, segredos ou o volume de storage.
# O iniciar-prod.bat fixa NODE_ENV=production, HOST=127.0.0.1 e portas 6050/6051/6060/6061/41110/41112.

FRONTEND_ORIGIN=https://site.rodogarcia.com.br
CORS_ORIGINS=https://site.rodogarcia.com.br
TRUST_PROXY=1

# CMS separado: o visitante acessa somente https://site.rodogarcia.com.br/admin.
# Estas URLs internas sao privadas e nao podem usar NEXT_PUBLIC_*.
CMS_INTERNAL_URL=http://127.0.0.1:6061
CMS_BACKEND_INTERNAL_URL=http://127.0.0.1:6051
CMS_BACKEND_PROXY_URL=http://127.0.0.1:6051
# Publica: usada no bundle do CMS somente para links, logo, previews e assets do site.
NEXT_PUBLIC_SITE_URL=https://site.rodogarcia.com.br

# Gere valores aleatorios fortes; nao reutilize os placeholders.
ADMIN_SETUP_CODE=altere-para-um-codigo-forte-com-16-caracteres-ou-mais
SESSION_SECRET=altere-para-um-segredo-longo-com-32-caracteres-ou-mais
# Obrigatório no backend público para capabilities opacas de NF/coleta.
# Não reutilize SESSION_SECRET ou GRAPHQL_API_KEY.
ESL_OPERATION_SECRET=altere-para-um-segredo-esl-com-32-caracteres-ou-mais

# Landing Builder: obrigatório para o ciclo integrado de produção. O inicializador usa somente loopback.
# Nunca use NEXT_PUBLIC_* para o token.
LANDING_BUILDER_SERVICE_TOKEN=altere-para-um-segredo-com-32-caracteres-ou-mais
LANDING_BUILDER_STORAGE_ROOT=C:\Rodogarcia\landing-builder-storage-prod
# Estas URLs privadas são fixadas pelo iniciar-prod.bat; o prefixo permanece público apenas como caminho do site.
LANDING_BUILDER_ASSET_PREFIX=/landing-assets

# Volume persistente fora do repositorio. Use caminhos absolutos na VM Windows.
STORAGE_ROOT=C:\Rodogarcia\storage-prod
UPLOADS_DIR=C:\Rodogarcia\storage-prod\uploads

# Opcional: origem inicial dos uploads legados ao criar um volume novo.
# Os arquivos ausentes sao copiados sem sobrescrever o volume persistente.
# PRODUCTION_UPLOADS_SEED_DIR=site\backend\storage\uploads

# Opcional e publico: hostname da API se algum cliente precisar acessa-la diretamente.
# O Next de producao usa BACKEND_INTERNAL_URL local para rewrites de /api e /uploads.
NEXT_PUBLIC_BACKEND_URL=https://sitebackend.rodogarcia.com.br

# Integração privada com o TMS ESL Cloud. A chave é enviada pelo backend como Bearer.
# GRAPHQL_API_KEY=cole-o-token-bearer-gerado-no-TMS-ESL
# ESL_TENANT=rodogarcia
# ESL_GRAPHQL_URL=https://rodogarcia.eslcloud.com.br/graphql
# Obrigatório para os backends Spring do CMS e Landing Builder: executáveis
# FFmpeg e FFprobe absolutos, existentes e estáveis fora do repositório/node_modules.
# FFMPEG_PATH=C:\Rodogarcia\tools\ffmpeg.exe
# FFPROBE_PATH=C:\Rodogarcia\tools\ffprobe.exe
