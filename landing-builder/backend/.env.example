# Backend Java 21/Spring Boot MVC. O token privado deve ser idêntico ao
# LANDING_BUILDER_SERVICE_TOKEN configurado no backend do CMS.
LANDING_BUILDER_SERVICE_TOKEN=altere-para-um-segredo-com-32-caracteres-ou-mais
HOST=127.0.0.1
PORT=36110
# Preferidos quando o processo compartilha o ambiente com outro backend.
# LANDING_BUILDER_HOST=127.0.0.1
# LANDING_BUILDER_PORT=36110
# Obrigatório em produção: volume absoluto, persistente e fora do repositório.
# LANDING_BUILDER_STORAGE_ROOT=C:\Rodogarcia\landing-builder-storage
# Obrigatório em produção para suporte a AVIF: executável absoluto, existente
# e estável fora do repositório e de node_modules.
# FFMPEG_PATH=C:\Rodogarcia\tools\ffmpeg.exe
# FFPROBE_PATH=C:\Rodogarcia\tools\ffprobe.exe
