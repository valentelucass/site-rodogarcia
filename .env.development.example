# Desenvolvimento local Rodogarcia. Copie para .env.development.local.
# O iniciar-dev.bat fixa NODE_ENV=development e as portas 31012/31013/35180/35013/36110/35112.
# Os três backends usam Spring MVC no DEV.

ADMIN_SETUP_CODE=altere-para-um-codigo-local
SESSION_SECRET=altere-para-um-segredo-local-com-mais-de-32-caracteres

# CMS separado no desenvolvimento. CMS_INTERNAL_URL, CMS_BACKEND_INTERNAL_URL e
# CMS_BACKEND_PROXY_URL sao privados;
# NEXT_PUBLIC_SITE_URL e publico e serve somente links/previews do site no navegador.
# O iniciar-dev.bat aplica estes mesmos valores e permite 35013 apenas para testes diretos do CMS.
CMS_INTERNAL_URL=http://127.0.0.1:35013
CMS_BACKEND_INTERNAL_URL=http://127.0.0.1:31013
CMS_BACKEND_PROXY_URL=http://127.0.0.1:31013
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:35180
CORS_ORIGINS=http://127.0.0.1:35180,http://localhost:35180,http://127.0.0.1:35013,http://localhost:35013

# Landing Builder iniciado junto com iniciar-dev.bat. O token permanece privado e deve ser igual nos dois backends.
LANDING_BUILDER_API_URL=http://127.0.0.1:36110
LANDING_BUILDER_PUBLIC_URL=http://127.0.0.1:35112
LANDING_BUILDER_ASSET_PREFIX=/landing-assets
# Se ausente, iniciar-dev.bat gera token temporário forte para a sessão atual.
# LANDING_BUILDER_SERVICE_TOKEN=defina-um-token-local-forte-para-preserva-lo-entre-reinicios
# Dev Tunnels são temporários: encaminhe a porta 35180 e não grave a URL pública aqui.

# Integração privada com o TMS ESL Cloud. Não exponha esta chave ao frontend.
# GRAPHQL_API_KEY=cole-o-token-bearer-gerado-no-TMS-ESL
# Opcional em desenvolvimento: sem ele o backend usa segredo efêmero e as
# capabilities de coleta expiram ao reiniciar o processo.
# ESL_OPERATION_SECRET=altere-para-um-segredo-local-com-32-caracteres-ou-mais
# ESL_TENANT=rodogarcia
# ESL_GRAPHQL_URL=https://rodogarcia.eslcloud.com.br/graphql

# Opcional: o iniciar-dev.bat usa sempre o storage local do repositorio.
# Nao aponte este ambiente para o volume de producao.
# Opcional em DEV/teste: caminhos do FFmpeg para conversão e do FFprobe para
# ler resolução/duração sem abrir o arquivo no navegador.
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
